{
  "name": "same-prompt-gallery",
  "private": true,
  "type": "module",
  "workspaces": [
    "results/*",
    "results/miniature-railway-town/*",
    "results/mechanical-keyboard/*",
    "results/boeing-787/*",
    "results/denza-z/*"
  ],
  "scripts": {
    "dev": "npm run build && vite preview --host 0.0.0.0 --port 5173",
    "dev:opus": "npm run dev --workspace=opus-5.5-high",
    "build": "npm run build --workspaces && node scripts/assemble.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "bake:previews": "node scripts/bake-previews.mjs",
    "check": "node scripts/check-syntax.mjs",
    "check:intake": "node scripts/check-intake.mjs",
    "capture:results": "node scripts/capture-results.mjs",
    "intake": "node scripts/intake.mjs",
    "readme": "node scripts/readme.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "three": "^0.186.1",
    "vite": "^7.3.6"
  }
}
