{
  "name": "same-prompt-gallery",
  "private": true,
  "type": "module",
  "workspaces": [
    "results/*",
    "results/miniature-railway-town/*",
    "results/mechanical-keyboard/*"
  ],
  "scripts": {
    "dev": "npm run build && vite preview --host 0.0.0.0 --port 5173",
    "dev:opus": "npm run dev --workspace=opus-5.5-high",
    "build": "npm run build --workspaces && node scripts/assemble.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check": "node --check site/app.js && node --check scripts/assemble.mjs"
  },
  "devDependencies": {
    "three": "^0.186.1",
    "vite": "^7.3.6"
  }
}
